<Window x:Class="GPOSettingsExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPO Settings Explorer"
        Width="1400" Height="850"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Domain:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBlock x:Name="DomainText"
                           Style="{StaticResource AdaptiveHeaderValue}"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0"/>

                <TextBlock Text="Connected DC:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBlock x:Name="ServerText"
                           Style="{StaticResource AdaptiveHeaderValue}"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0"/>

                <TextBlock x:Name="HeaderStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           MinWidth="180"
                           MaxWidth="420"
                           Margin="0,0,10,0"/>

                <Button Content="Connection..."
                        Click="Connection_Click"/>

                <ToggleButton x:Name="WriteModeToggle"
                              Style="{StaticResource UiWriteModeToggle}"
                              Content="Safe mode: READ ONLY"
                              Checked="WriteModeToggle_Changed"
                              Unchecked="WriteModeToggle_Changed"
                              ToolTip="Write operations are blocked while Safe mode is active."/>

                <TextBox x:Name="GlobalSearchBox"
                         Width="220"
                         ToolTip="Search GPOs, settings, scripts, WMI filters and loaded preference items."
                         KeyDown="GlobalSearchBox_KeyDown"/>

                <Button Content="Search"
                        Style="{StaticResource UiPrimaryButton}"
                        Click="GlobalSearch_Click"/>

                <Button Content="Diagnostics"
                        Click="Diagnostics_Click"/>

                <Button x:Name="PendingDiagnosticsButton"
                        Content="Diagnostics pending"
                        Style="{StaticResource UiPendingDiagnosticsButton}"
                        ToolTip="Review accumulated local diagnostics and choose whether to submit them."
                        Visibility="Collapsed"
                        Click="PendingDiagnostics_Click"/>

                <Button x:Name="UpdateButton"
                        Content="Check updates"
                        Click="CheckUpdates_Click"/>

                <Button Content="Refresh all"
                        Click="RefreshAll_Click"/>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           TextWrapping="Wrap"
                           TextTrimming="None"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="BusyProgress" Width="180" Height="14" IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="GposTab"
                     Header="GPOs">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel>
                            <TextBlock Text="Search:" VerticalAlignment="Center"/>
                            <TextBox x:Name="GpoSearchBox" Width="300" TextChanged="GpoSearchBox_TextChanged"/>
                            <TextBlock Text="View:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <ComboBox x:Name="GpoQuickFilterCombo"
                                      Width="115"
                                      SelectionChanged="GpoQuickFilterCombo_SelectionChanged"/>
                            <Button x:Name="FavoriteGpoButton"
                                    Content="★ Favorite"
                                    Click="ToggleFavoriteGpo_Click"/>
                            <Button Content="New GPO..." Click="NewGpo_Click"/>
                            <Button Content="Copy GPO..." Click="CopyGpo_Click"/>
                            <Button x:Name="RenameGpoButton" Content="Rename" Click="RenameGpo_Click"/>
                            <Button x:Name="DeleteGpoButton" Content="Delete" Click="DeleteGpo_Click"/>
                            <Button Content="Open editor" Click="OpenGpoEditor_Click"/>
                            <Button Content="GPO Hierarchy &amp; Links"
                                    Click="OpenHierarchyLinksTab_Click"
                                    Style="{StaticResource UiPrimaryButton}"
                                    ToolTip="Open the combined GPO hierarchy tree and link management pane."/>
                            <Button Content="Backup selected" Click="BackupSelectedGpo_Click"/>
                            <Button Content="Build settings index" Click="BuildSettingsIndex_Click"/>
                            <Separator Width="12"/>
                            <Button x:Name="ToggleComputerButton" Content="Toggle Computer" Click="ToggleComputerScope_Click"/>
                            <Button x:Name="ToggleUserButton" Content="Toggle User" Click="ToggleUserScope_Click"/>
                            <Separator Width="12"/>
                            <Button x:Name="AssignWmiButton" Content="Assign WMI filter" Click="AssignWmiFilter_Click"/>
                            <Button x:Name="RemoveWmiButton" Content="Remove WMI filter" Click="RemoveWmiFilter_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="SelectedGpoAccessText"
                                   Margin="4,2,4,4"
                                   TextWrapping="Wrap"
                                   Foreground="DimGray"/>
                    </StackPanel>
                    <DataGrid x:Name="GpoGrid"
                              RowStyle="{StaticResource UiGpoRowStyle}"
                              MouseDoubleClick="GpoGrid_MouseDoubleClick"
                              SelectionChanged="GpoGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="★" Binding="{Binding FavoriteMark}" Width="42"/>
                            <DataGridTextColumn Header="Recent" Binding="{Binding RecentMark}" Width="62"/>
                            <DataGridTextColumn Header="GPO" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeState}" Width="150"/>
                            <DataGridTextColumn Header="WMI Filter" Binding="{Binding WmiFilterName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModificationTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155"/>
                            <DataGridTextColumn Header="GUID" Binding="{Binding IdText}" Width="270"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="AllSettingsTab" Header="All Settings">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <TextBlock Text="Find any setting:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="UnifiedSearchBox" Width="330" MinWidth="170"
                                         TextChanged="UnifiedSearchBox_TextChanged"
                                         ToolTip="Search ADMX templates, GPMC configured settings and verified MMC inventory."/>
                                <TextBlock Text="Source:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="UnifiedSourceCombo" Width="155"
                                          SelectionChanged="UnifiedFilterChanged"
                                          ToolTip="Show all available evidence or only one source."/>
                                <TextBlock Text="State:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="UnifiedStateCombo" Width="135"
                                          SelectionChanged="UnifiedFilterChanged"/>
                            </WrapPanel>
                            <WrapPanel>
                                <CheckBox x:Name="UnifiedAllGposCheckBox"
                                          Content="All GPOs" IsChecked="True"
                                          VerticalAlignment="Center" Margin="5,0,6,0"
                                          Checked="UnifiedFilterChanged"
                                          Unchecked="UnifiedFilterChanged"/>
                                <ComboBox x:Name="UnifiedGpoFilterCombo"
                                          Width="320" MinWidth="190"
                                          DisplayMemberPath="DisplayName"
                                          ItemsSource="{Binding ElementName=GpoGrid, Path=ItemsSource}"
                                          SelectionChanged="UnifiedFilterChanged"
                                          ToolTip="Select one GPO to compare its configured settings with ADMX templates."/>
                                <CheckBox x:Name="UnifiedShowTechnicalCheckBox"
                                          Content="Show XML details" IsChecked="False"
                                          VerticalAlignment="Center" Margin="6,0,6,0"
                                          Checked="UnifiedFilterChanged"
                                          Unchecked="UnifiedFilterChanged"
                                          ToolTip="Show low-level GPMC XML descriptors such as security group Member and Registry ACL. These are read-only descriptions, not independently editable policies."/>
                                <Button Content="Refresh catalog" Click="RefreshUnifiedSettings_Click"/>
                                <Button x:Name="ImpactPreviewButton" Content="Impact / RSoP preview" Click="GpoImpactPreview_Click" ToolTip="Direct GPO link inventory plus optional logged gpresult verification on one computer. Never estimates domain-wide application."/>
                                <Button x:Name="GpoHealthButton" Content="Health check (AD/SYSVOL)" Click="GpoHealth_Click" ToolTip="Read-only integrity check of AD versionNumber, GPT.INI, source files on selected pinned DC."/>
                                <Button x:Name="ReadRealSourcesButton"
                                        Content="Read selected GPO files"
                                        Click="ReadRealSources_Click"
                                        ToolTip="Read-only inspection of Machine/User Registry.pol and Machine SecEdit GptTmpl.inf on the pinned domain controller. Select a GPO first. Never edits or applies policies."/>
                                <Button x:Name="SecurityEditSourceButton" Content="Edit stored security..." Click="EditSecuritySource_Click" IsEnabled="False" ToolTip="Only selected, recognized existing Event Audit and System Access values. Requires WRITE ENABLED, backup, source SHA-256 match and preview."/>
                                <Button x:Name="UnifiedActionButton"
                                        Content="View / Edit..."
                                        Style="{StaticResource UiPrimaryButton}"
                                        Click="EditUnifiedSetting_Click"
                                        ToolTip="The selected row determines whether this opens an editor, a read-only value, or a verified MMC row."/>
                                <Button Content="Open GPO" Click="OpenUnifiedSettingGpo_Click"/>
                                <Button Content="Export CSV" Click="ExportUnifiedSettings_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="UnifiedSettingsCountText"
                                       Margin="4,3,4,5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource UiMutedBrush}"
                                       Text="Unified catalog: GPMC/ADMX/MMC; optional Read selected GPO files shows actual stored Registry.pol and GptTmpl.inf entries (not effective RSoP)."/>
                            <TextBlock x:Name="UnifiedSelectedDetailsText"
                                       Margin="4,1,4,5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource UiMutedBrush}"
                                       Text="Select a setting to see source evidence, read state and supported editing route."/>
                        </StackPanel>
                        <DataGrid x:Name="UnifiedSettingsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  RowStyle="{StaticResource UiPolicyRowStyle}"
                                  SelectionMode="Single"
                                  SelectionChanged="UnifiedSettingsGrid_SelectionChanged"
                                  MouseDoubleClick="UnifiedSettingsGrid_MouseDoubleClick"
                                  ToolTip="Double-click to open the safest available editor or inspect the selected setting.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="2.2*"/>
                                <DataGridTextColumn Header="GPO / Target" Binding="{Binding GpoName}" Width="1.5*"/>
                                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="95"/>
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150"/>
                                <DataGridTextColumn Header="Value / summary" Binding="{Binding Value}" Width="1.4*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.6*"/>
                                <DataGridTextColumn Header="Source evidence" Binding="{Binding Sources}" Width="170"/>
                                <DataGridTextColumn Header="Edit capability" Binding="{Binding Capability}" Width="185"/>
                                <DataGridTextColumn Header="Registry target" Binding="{Binding RegistryTarget}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Expander x:Name="AdvancedSourcesExpander" Grid.Row="1"
                              Header="Advanced sources and diagnostics (GPMC / MMC / ADMX)"
                              IsExpanded="False"
                              ToolTip="Original source lists and manual MMC inventory live here. All existing editing commands remain available.">
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1" Padding="2" MaxHeight="430">
                <TabControl x:Name="AllSettingsSubTabs" Margin="3"
                            SelectionChanged="AllSettingsSubTabs_SelectionChanged">
                    <TabItem Header="Configured GPMC settings">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search all configured settings:" VerticalAlignment="Center"/>
                        <TextBox x:Name="SettingsSearchBox" Width="460" TextChanged="SettingsSearchBox_TextChanged"/>
                        <Button Content="Rebuild index" Click="BuildSettingsIndex_Click"/>
                        <Button Content="Edit setting" Click="EditSetting_Click"/>
                        <Button Content="Open selected GPO" Click="OpenSettingGpo_Click"/>
                        <Button Content="Export CSV" Click="ExportSettingsCsv_Click"/>
                        <TextBlock x:Name="SettingsCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid x:Name="SettingsGrid" RowStyle="{StaticResource UiPolicyRowStyle}" MouseDoubleClick="EditSetting_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.4*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                            <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="2*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.6*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding RegistryKey}" Width="1.5*"/>
                            <DataGridTextColumn Header="Registry value" Binding="{Binding RegistryValue}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                    </TabItem>
                    <TabItem Header="MMC Full Settings Inventory">
                        <DockPanel Margin="6">
                            <StackPanel DockPanel.Dock="Top">
                                <WrapPanel>
                                    <TextBlock Text="Reference GPO:" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MmcInventoryGpoCombo" Width="350" MinWidth="220"
                                              DisplayMemberPath="DisplayName"
                                              ItemsSource="{Binding ElementName=GpoGrid, Path=ItemsSource}"
                                              ToolTip="One GPO editor is inspected per scan. The resulting MMC policy view is local to this computer."/>
                                    <Button x:Name="MmcInventoryScanButton"
                                            Content="Scan MMC (read-only)"
                                            Style="{StaticResource UiPrimaryButton}"
                                            Click="ScanMmcInventory_Click"/>
                                    <Button x:Name="MmcInventoryCancelButton"
                                            Content="Cancel scan" IsEnabled="False"
                                            Click="CancelMmcInventory_Click"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock Text="Search:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MmcInventorySearchBox" Width="290" MinWidth="175"
                                             TextChanged="MmcInventorySearchBox_TextChanged"/>
                                    <Button Content="Open exact in MMC..." Click="OpenMmcInventoryRow_Click"
                                            ToolTip="Open only a uniquely verified literal row in the standard MMC editor. No automatic GPO write."/>
                                    <Button Content="Export CSV..." Click="ExportMmcInventory_Click"/>
                                    <TextBlock x:Name="MmcInventoryShownCountText" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource UiMutedBrush}"/>
                                </WrapPanel>
                                <TextBlock Text="MMC inventory scans native policy lists. Unsafe MMC Scripts snap-ins are deliberately SKIPPED (use GPO Scripts tab). A modal snap-in error stops the scan; it is never auto-dismissed. Rows are observations, NOT effective RSoP; PARTIAL coverage lists skipped/inaccessible sections."
                                           TextWrapping="Wrap" Margin="4,3,4,4"
                                           Foreground="{DynamicResource UiWarningBrush}"/>
                                <TextBlock x:Name="MmcInventoryCoverageText"
                                           Text="No MMC inventory yet. Select a reference GPO and scan."
                                           TextWrapping="Wrap" Margin="4,2,4,6"
                                           Foreground="{DynamicResource UiAccentBrush}"/>
                            </StackPanel>
                            <TabControl x:Name="MmcInventoryResultTabs">
                                <TabItem Header="Observed settings / rows">
                                    <DataGrid x:Name="MmcInventoryGrid" IsReadOnly="True"
                                              MouseDoubleClick="MmcInventoryGrid_MouseDoubleClick"
                                              AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Setting / row" Binding="{Binding SettingName}" Width="2*"/>
                                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                                            <DataGridTextColumn Header="MMC state" Binding="{Binding MmcState}" Width="160"/>
                                            <DataGridTextColumn Header="MMC value" Binding="{Binding MmcValue}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Section path" Binding="{Binding SectionPath}" Width="2*"/>
                                            <DataGridTextColumn Header="GPMC XML" Binding="{Binding GpmcMatch}" Width="1.8*"/>
                                            <DataGridTextColumn Header="ADMX" Binding="{Binding AdmxMatch}" Width="1.4*"/>
                                            <DataGridTextColumn Header="Edit route" Binding="{Binding Navigation}" Width="170"/>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Coverage / skipped sections">
                                    <DataGrid x:Name="MmcInventorySectionsGrid" IsReadOnly="True"
                                              AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                            <DataGridTextColumn Header="Rows" Binding="{Binding RowCount}" Width="80"/>
                                            <DataGridTextColumn Header="MMC section" Binding="{Binding Path}" Width="2.3*"/>
                                            <DataGridTextColumn Header="Diagnostic" Binding="{Binding Details}" Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </TabItem>
            <TabItem x:Name="AdmxCatalogTab"
                     Header="ADMX definitions (advanced)">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search all Administrative Template policies:" VerticalAlignment="Center"/>
                        <TextBox x:Name="AdmxSearchBox" Width="440" TextChanged="AdmxSearchBox_TextChanged"/>
                        <Button Content="Load catalog" Click="LoadAdmxCatalog_Click"/>
                        <Button Content="Configure in GPO..." Click="ConfigureAdmxPolicy_Click"/>
                        <TextBlock x:Name="AdmxCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid x:Name="AdmxGrid" MouseDoubleClick="AdmxGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="100"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.7*"/>
                            <DataGridTextColumn Header="ADMX" Binding="{Binding AdmxFile}" Width="160"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding Key}" Width="1.5*"/>
                            <DataGridTextColumn Header="Registry value" Binding="{Binding ValueName}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
                </TabControl>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem x:Name="GpoScriptsTab"
                     Header="GPO Scripts">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="Filter files:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GpoScriptsFilterBox"
                                 Width="300"
                                 TextChanged="GpoScriptsFilterBox_TextChanged"/>
                        <Button Content="Refresh"
                                Click="RefreshGpoScripts_Click"/>
                        <Button Content="Edit"
                                Click="EditGpoScript_Click"/>
                        <Button Content="Copy path"
                                Click="CopyGpoScriptPath_Click"/>
                        <TextBlock x:Name="GpoScriptsCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GpoScriptsGrid"
                              RowStyle="{StaticResource UiScriptRowStyle}"
                              Grid.Row="1"
                              MouseDoubleClick="GpoScriptsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO"
                                                Binding="{Binding GpoName}"
                                                Width="1.5*"/>
                            <DataGridTextColumn Header="Scope"
                                                Binding="{Binding Scope}"
                                                Width="85"/>
                            <DataGridTextColumn Header="Event"
                                                Binding="{Binding EventName}"
                                                Width="95"/>
                            <DataGridTextColumn Header="Order"
                                                Binding="{Binding OrderText}"
                                                Width="60"/>
                            <DataGridTextColumn Header="File"
                                                Binding="{Binding FileName}"
                                                Width="1.1*"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding Type}"
                                                ElementStyle="{StaticResource UiScriptTypeTextStyle}"
                                                Width="70"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding StatusText}"
                                                ElementStyle="{StaticResource UiScriptStatusTextStyle}"
                                                Width="175"/>
                            <DataGridTextColumn Header="Parameters"
                                                Binding="{Binding Parameters}"
                                                Width="1.2*"/>
                            <DataGridCheckBoxColumn Header="Referenced"
                                                    Binding="{Binding Referenced, Mode=OneWay}"
                                                    IsReadOnly="True"
                                                    Width="85"/>
                            <DataGridCheckBoxColumn Header="Exists"
                                                    Binding="{Binding Exists, Mode=OneWay}"
                                                    IsReadOnly="True"
                                                    Width="65"/>
                            <DataGridTextColumn Header="Modified"
                                                Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                Width="145"/>
                            <DataGridTextColumn Header="Path"
                                                Binding="{Binding FullPath}"
                                                Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2"
                            Margin="0,6,0,4"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="0,1,0,0"
                            Padding="0,6,0,0">
                        <WrapPanel>
                            <TextBlock Text="Find in scripts:"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="GpoScriptContentSearchBox"
                                     Width="300"/>
                            <ComboBox x:Name="GpoScriptSearchScopeCombo"
                                      Width="120"/>
                            <Button Content="Find"
                                    Style="{StaticResource UiPrimaryButton}"
                                    Click="SearchGpoScriptContent_Click"/>
                            <TextBlock x:Name="GpoScriptSearchCountText"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource UiMutedBrush}"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="GpoScriptSearchResultsGrid"
                              Grid.Row="3"
                              MouseDoubleClick="GpoScriptSearchResultsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File"
                                                Binding="{Binding FileName}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding Type}"
                                                ElementStyle="{StaticResource UiScriptTypeTextStyle}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Line"
                                                Binding="{Binding LineNumber}"
                                                Width="65"/>
                            <DataGridTextColumn Header="Match type"
                                                Binding="{Binding MatchType}"
                                                ElementStyle="{StaticResource UiScriptMatchTextStyle}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Match"
                                                Binding="{Binding LineText}"
                                                Width="3*"/>
                            <DataGridTemplateColumn Header="Copies" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding CopiesLabel}"
                                                Style="{StaticResource UiScriptCopiesButton}"
                                                IsEnabled="{Binding HasMultipleCopies}"
                                                PreviewMouseDoubleClick="ScriptCopies_PreviewMouseDoubleClick"
                                                Click="ScriptCopies_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="GPO refs"
                                                Binding="{Binding GpoReferenceCount}"
                                                Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="GppPreferencesTab" Header="Preferences (GPP)">
                <TabControl x:Name="GppPreferencesTabs" Margin="6" TabStripPlacement="Top"
                            ToolTip="Original GPP editors are grouped here to keep primary navigation compact.">
            <TabItem Header="GPP Data Sources"
                     Loaded="GppDataSourcesTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppDataSourcesSearchBox"
                                 Width="280"
                                 TextChanged="GppDataSourcesSearchBox_TextChanged"/>
                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppDataSourcesScopeCombo"
                                  Width="105"
                                  SelectionChanged="GppDataSourcesFilter_SelectionChanged"/>
                        <TextBlock Text="Type:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppDataSourcesTypeCombo"
                                  Width="120"
                                  SelectionChanged="GppDataSourcesFilter_SelectionChanged"/>
                        <Button Content="Load all" Click="LoadGppDataSources_Click"/>
                        <Button Content="New..." Click="NewGppDataSource_Click"/>
                        <Button Content="Edit" Click="EditGppDataSource_Click"/>
                        <Button Content="Clone..." Click="CloneGppDataSource_Click"/>
                        <Button Content="Delete" Click="DeleteGppDataSource_Click"/>
                        <Button Content="Show raw XML" Click="ShowGppDataSourceRawXml_Click"/>
                        <TextBlock x:Name="GppDataSourcesCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppDataSourcesGrid"
                              MouseDoubleClick="GppDataSourcesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="85"/>
                            <DataGridTextColumn Header="DSN type" Binding="{Binding DsnTypeDisplay}" Width="100"/>
                            <DataGridTextColumn Header="DSN" Binding="{Binding Dsn}" Width="1.2*"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="1.5*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding DsnDescription}" Width="1.4*"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="1.1*"/>
                            <DataGridTextColumn Header="Attributes" Binding="{Binding AttributesPreview}" Width="2*"/>
