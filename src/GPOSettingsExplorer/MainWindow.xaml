            <TabItem x:Name="GpoLinksTab" Header="GPO Hierarchy &amp; Links">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.95*" MinWidth="245"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="1.65*" MinWidth="410"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="9" Margin="0,0,2,0" BorderThickness="1"
                            BorderBrush="{DynamicResource UiAccentBrush}" CornerRadius="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="1  GPO HIERARCHY / ORDER"
                                           FontWeight="SemiBold" Foreground="{DynamicResource UiAccentBrush}"/>
                                <TextBlock Text="Browse Sites, Domain and OUs. Link order 1 has highest priority within its container."
                                           TextWrapping="Wrap" Margin="0,4,0,7"
                                           Foreground="{DynamicResource UiMutedBrush}"/>
                                <WrapPanel>
                                    <TextBox x:Name="HierarchySearchBox" MinWidth="135" Width="235"
                                             ToolTip="Find an OU, site, domain or linked GPO"
                                             TextChanged="HierarchySearchBox_TextChanged"/>
                                    <Button Content="Expand" Click="ExpandGpoHierarchy_Click"/>
                                    <Button Content="Collapse" Click="CollapseGpoHierarchy_Click"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="Refresh hierarchy" Click="LoadLinks_Click"
                                            Style="{StaticResource UiPrimaryButton}"/>
                                    <Button Content="Full view..." Click="ShowGpoHierarchy_Click"/>
                                    <Button Content="Export..." Click="ExportGpoHierarchy_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="HierarchyCountText" Margin="2,5,0,7"
                                           Text="Open this tab to load the hierarchy."
                                           Foreground="{DynamicResource UiMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TreeView x:Name="GpoHierarchyTree"
                                      SelectedItemChanged="GpoHierarchyTree_SelectedItemChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="7"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>

                    <Border Grid.Column="2" Margin="2,0,0,0" Padding="9" BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            CornerRadius="5">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="2  GPO LINKS / MANAGEMENT"
                                           FontWeight="SemiBold" Foreground="{DynamicResource UiAccentBrush}"/>
                                <TextBlock Text="Select a linked GPO in the tree on the left, then edit its link here. Changes require WRITE mode, preview and confirmation."
                                           Foreground="{DynamicResource UiMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,7"/>
                                <WrapPanel>
                                    <TextBlock Text="Find link:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="LinkSearchBox" MinWidth="160" Width="245"
                                             TextChanged="LinkSearchBox_TextChanged"/>
                                    <Button Content="Refresh links" Click="LoadLinks_Click"/>
                                    <Button Content="All links" Click="ShowAllGpoLinks_Click"
                                            ToolTip="Clear OU selection and show every direct GPO link."/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="New link..." Click="NewLink_Click"/>
                                    <Button Content="Edit selected link..." Click="EditLink_Click"
                                            Style="{StaticResource UiPrimaryButton}"/>
                                    <Button Content="Remove link" Click="RemoveLink_Click"/>
                                    <Button Content="Toggle block inheritance" Click="ToggleBlockInheritance_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="LinksCountText" Margin="2,5,0,3"
                                           Foreground="{DynamicResource UiMutedBrush}"/>
                                <TextBlock x:Name="LinkSelectionHint"
                                           Text="Select a GPO link in the tree or the list."
                                           TextWrapping="Wrap" Margin="2,0,0,8"
                                           Foreground="{DynamicResource UiMutedBrush}"/>
                            </StackPanel>
                            <DataGrid x:Name="LinksGrid" IsReadOnly="True"
                                      MouseDoubleClick="LinksGrid_MouseDoubleClick"
                                      SelectionChanged="LinksGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TargetType}" Width="90"/>
                                    <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, Mode=OneWay}"
                                                            IsReadOnly="True" Width="80"/>
                                    <DataGridCheckBoxColumn Header="Enforced" Binding="{Binding Enforced, Mode=OneWay}"
                                                            IsReadOnly="True" Width="80"/>
                                    <DataGridCheckBoxColumn Header="Block inheritance"
                                                            Binding="{Binding BlockInheritance, Mode=OneWay}"
                                                            IsReadOnly="True" Width="120"/>
                                    <DataGridTextColumn Header="Target DN" Binding="{Binding TargetDn}" Width="2.2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SecurityTab"
                     Header="Security &amp; Delegation">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="GPO:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SecurityGpoCombo"
                                  Width="330"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="SecurityGpoCombo_SelectionChanged"/>
                        <Button Content="Refresh" Click="RefreshSecurity_Click"/>
                        <Separator Width="12"/>
                        <Button x:Name="AddSecurityFilterButton" Content="Add Security Filter..." Click="AddSecurityFilter_Click"/>
                        <Button x:Name="AddDelegationButton" Content="Add Delegation..." Click="AddDelegation_Click"/>
                        <Button x:Name="ChangePermissionButton" Content="Change..." Click="ChangePermission_Click"/>
                        <Button x:Name="RemovePermissionButton" Content="Remove" Click="RemovePermission_Click"/>
                        <Separator Width="12"/>
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PermissionSearchBox" Width="230" TextChanged="PermissionSearchBox_TextChanged"/>
                        <TextBlock x:Name="PermissionCountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid x:Name="PermissionGrid" MouseDoubleClick="PermissionGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Trustee" Binding="{Binding TrusteeDisplay}" Width="1.5*"/>
                            <DataGridTextColumn Header="Permission" Binding="{Binding PermissionDisplay}" Width="1.7*"/>
                            <DataGridCheckBoxColumn Header="Inherited" Binding="{Binding Inherited, Mode=OneWay}" IsReadOnly="True"
                                                    Width="80"/>
                            <DataGridCheckBoxColumn Header="Denied" Binding="{Binding Denied, Mode=OneWay}" IsReadOnly="True"
                                                    Width="70"/>
                            <DataGridTextColumn Header="SID" Binding="{Binding TrusteeSid}" Width="1.5*"/>
                            <DataGridTextColumn Header="Directory path" Binding="{Binding TrusteeDsPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="BackupsTab" Header="Backups" Loaded="BackupsTab_Loaded">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <WrapPanel>
                            <TextBlock Text="Backup directory:" VerticalAlignment="Center"/>
                            <TextBox x:Name="BackupsPathBox" Width="560"/>
                            <Button Content="Refresh" Click="RefreshBackups_Click"/>
                            <Button Content="Open folder" Click="OpenBackupFolder_Click"/>
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="BackupSearchBox"
                                     Width="230"
                                     TextChanged="BackupSearchBox_TextChanged"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Restore selected" Click="RestoreBackup_Click"/>
                            <Button Content="Selective restore security..." Click="SelectiveRestoreSetting_Click" ToolTip="Restore ONE existing, reviewed Security Settings numeric value from the same-domain GPMC backup. No ACL/rights or bulk restore."/>
                            <Button Content="Import into GPO..." Click="ImportBackup_Click"/>
                            <Button Content="Generate report" Click="BackupReport_Click"/>
                            <Button Content="Compare with current" Click="CompareBackupWithCurrent_Click"/>
                            <Button Content="Delete backup" Click="DeleteBackup_Click"/>
                            <TextBlock x:Name="BackupCountText"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="DimGray"/>
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid x:Name="BackupsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding DisplayName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Domain" Binding="{Binding DomainName}" Width="150"/>
                            <DataGridTextColumn Header="Backup time" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="165"/>
                            <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="2*"/>
                            <DataGridTextColumn Header="GPO GUID" Binding="{Binding GpoIdText}" Width="270"/>
                            <DataGridTextColumn Header="Backup ID" Binding="{Binding BackupIdText}" Width="270"/>
                            <DataGridTextColumn Header="Directory" Binding="{Binding BackupDirectory}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="AuditTab" Header="Audit Log" Loaded="AuditTab_Loaded">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <WrapPanel>
                            <TextBlock Text="Audit directory:" VerticalAlignment="Center"/>
                            <TextBox x:Name="AuditPathBox" Width="520"/>
                            <Button Content="Refresh" Click="RefreshAudit_Click"/>
                            <Button Content="Open folder" Click="OpenAuditFolder_Click"/>
                            <Button Content="Export CSV" Click="ExportAuditCsv_Click"/>
                            <Button Content="View details" Click="ViewAuditEntry_Click"/>
                            <Button Content="Open linked backup" Click="OpenAuditBackup_Click"/>
                            <Button Content="Restore linked backup" Click="RestoreAuditBackup_Click"/>
                            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="AuditSearchBox"
                                     Width="260"
                                     TextChanged="AuditSearchBox_TextChanged"/>
                            <TextBlock x:Name="AuditCountText"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="DimGray"/>
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid x:Name="AuditGrid"
                              MouseDoubleClick="AuditGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="190"/>
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="170"/>
                            <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" Width="130"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="135"/>
                            <DataGridTextColumn Header="Object type" Binding="{Binding ObjectType}" Width="125"/>
                            <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="1.5*"/>
                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="CompareTab" Header="Compare &amp; Conflicts">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="Left GPO:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CompareLeftGpoCombo"
                                  Width="280"
                                  ItemsSource="{Binding ElementName=GpoGrid, Path=ItemsSource}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="4"/>
                        <TextBlock Text="Right GPO:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="CompareRightGpoCombo"
                                  Width="280"
                                  ItemsSource="{Binding ElementName=GpoGrid, Path=ItemsSource}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="4"/>
                        <Button Content="Compare" Click="CompareGpos_Click"/>
                        <Button Content="Find conflicts &amp; duplicates" Click="FindConflicts_Click"/>
                        <Button Content="Explain / Actions..." Click="ConflictDetails_Click"/>
                        <CheckBox x:Name="CompareDifferencesOnlyCheck"
                                  Content="Differences only"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Checked="CompareFilter_Changed"
                                  Unchecked="CompareFilter_Changed"/>
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="CompareSearchBox"
                                 Width="220"
                                 TextChanged="CompareSearchBox_TextChanged"/>
                    </WrapPanel>

                    <TabControl Grid.Row="1" x:Name="CompareResultTabs">
                        <TabItem Header="GPO Compare">
                            <DockPanel>
                                <TextBlock x:Name="CompareCountText"
                                           DockPanel.Dock="Top"
                                           Margin="6"
                                           Foreground="DimGray"/>
                                <DataGrid x:Name="CompareGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                                        <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="2*"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Left state" Binding="{Binding LeftState}" Width="95"/>
                                        <DataGridTextColumn Header="Left value" Binding="{Binding LeftValue}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Right state" Binding="{Binding RightState}" Width="95"/>
                                        <DataGridTextColumn Header="Right value" Binding="{Binding RightValue}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Registry key" Binding="{Binding RegistryKey}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Registry value" Binding="{Binding RegistryValue}" Width="1.1*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Conflicts &amp; Duplicates">
                            <DockPanel>
                                <TextBlock x:Name="ConflictCountText"
                                           DockPanel.Dock="Top"
                                           Margin="6"
                                           Foreground="DimGray"/>
                                <DataGrid x:Name="ConflictGrid" MouseDoubleClick="ConflictGrid_MouseDoubleClick"
                                          RowStyle="{StaticResource UiConflictRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="120"/>
                                        <DataGridTextColumn Header="Overlap" Binding="{Binding OverlapStatus}" Width="165"/>
                                        <DataGridTextColumn Header="RSoP / WMI / Security check"
                                                            Binding="{Binding VerificationStatus}" Width="210"/>
                                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                                        <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="1.8*"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.4*"/>
                                        <DataGridTextColumn Header="GPOs" Binding="{Binding Gpos}" Width="2*"/>
                                        <DataGridTextColumn Header="States / values" Binding="{Binding Variants}" Width="2.2*"/>
                                        <DataGridTextColumn Header="Recommended action" Binding="{Binding Recommendation}" Width="2.5*"/>
                                        <DataGridTextColumn Header="Registry key" Binding="{Binding RegistryKey}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Registry value" Binding="{Binding RegistryValue}" Width="1.1*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <TabItem Header="WMI Filters">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="WmiSearchBox" Width="340" TextChanged="WmiSearchBox_TextChanged"/>
                        <Button Content="New" Click="NewWmiFilter_Click"/>
                        <Button Content="Edit" Click="EditWmiFilter_Click"/>
                        <Button Content="Clone" Click="CloneWmiFilter_Click"/>
                        <Button Content="Delete" Click="DeleteWmiFilter_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Test on computer..." Click="TestWmiFilter_Click"/>
                        <Button Content="Show used GPOs" Click="ShowWmiUsage_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="WmiGrid" MouseDoubleClick="WmiGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.8*"/>
                            <DataGridTextColumn Header="Used by GPOs" Binding="{Binding UsedByCount}" Width="100"/>
                            <DataGridTextColumn Header="Rules" Binding="{Binding QueriesPreview}" Width="2.4*"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1.1*"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ChangeDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="270"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
