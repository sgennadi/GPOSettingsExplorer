<Window x:Class="GPOSettingsExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPO Settings Explorer"
        Width="1400" Height="850"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="MainWindow_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Domain:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBlock x:Name="DomainText"
                           Style="{StaticResource AdaptiveHeaderValue}"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0"/>

                <TextBlock Text="Connected DC:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>
                <TextBlock x:Name="ServerText"
                           Style="{StaticResource AdaptiveHeaderValue}"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0"/>

                <TextBlock x:Name="HeaderStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           TextTrimming="None"
                           MinWidth="180"
                           MaxWidth="640"
                           Margin="0,0,10,0"/>

                <Button Content="Refresh all"
                        Click="RefreshAll_Click"/>
            </WrapPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           TextWrapping="Wrap"
                           TextTrimming="None"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="BusyProgress" Width="180" Height="14" IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs">
            <TabItem Header="GPOs">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GpoSearchBox" Width="340" TextChanged="GpoSearchBox_TextChanged"/>
                        <Button Content="New GPO..." Click="NewGpo_Click"/>
                        <Button Content="Copy GPO..." Click="CopyGpo_Click"/>
                        <Button Content="Rename" Click="RenameGpo_Click"/>
                        <Button Content="Delete" Click="DeleteGpo_Click"/>
                        <Button Content="Open editor" Click="OpenGpoEditor_Click"/>
                        <Button Content="Backup selected" Click="BackupSelectedGpo_Click"/>
                        <Button Content="Build settings index" Click="BuildSettingsIndex_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Toggle Computer" Click="ToggleComputerScope_Click"/>
                        <Button Content="Toggle User" Click="ToggleUserScope_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Assign WMI filter" Click="AssignWmiFilter_Click"/>
                        <Button Content="Remove WMI filter" Click="RemoveWmiFilter_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="GpoGrid" MouseDoubleClick="GpoGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeState}" Width="150"/>
                            <DataGridTextColumn Header="WMI Filter" Binding="{Binding WmiFilterName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModificationTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155"/>
                            <DataGridTextColumn Header="GUID" Binding="{Binding IdText}" Width="270"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="All Settings">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search all configured settings:" VerticalAlignment="Center"/>
                        <TextBox x:Name="SettingsSearchBox" Width="460" TextChanged="SettingsSearchBox_TextChanged"/>
                        <Button Content="Rebuild index" Click="BuildSettingsIndex_Click"/>
                        <Button Content="Edit setting" Click="EditSetting_Click"/>
                        <Button Content="Open selected GPO" Click="OpenSettingGpo_Click"/>
                        <Button Content="Export CSV" Click="ExportSettingsCsv_Click"/>
                        <TextBlock x:Name="SettingsCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid x:Name="SettingsGrid" MouseDoubleClick="EditSetting_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.4*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                            <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="2*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.6*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding RegistryKey}" Width="1.5*"/>
                            <DataGridTextColumn Header="Registry value" Binding="{Binding RegistryValue}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="ADMX Catalog">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search all Administrative Template policies:" VerticalAlignment="Center"/>
                        <TextBox x:Name="AdmxSearchBox" Width="440" TextChanged="AdmxSearchBox_TextChanged"/>
                        <Button Content="Load catalog" Click="LoadAdmxCatalog_Click"/>
                        <Button Content="Configure in GPO..." Click="ConfigureAdmxPolicy_Click"/>
                        <TextBlock x:Name="AdmxCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </WrapPanel>
                    <DataGrid x:Name="AdmxGrid" MouseDoubleClick="AdmxGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="100"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.7*"/>
                            <DataGridTextColumn Header="ADMX" Binding="{Binding AdmxFile}" Width="160"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding Key}" Width="1.5*"/>
                            <DataGridTextColumn Header="Registry value" Binding="{Binding ValueName}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Data Sources"
                     Loaded="GppDataSourcesTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppDataSourcesSearchBox"
                                 Width="280"
                                 TextChanged="GppDataSourcesSearchBox_TextChanged"/>
                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppDataSourcesScopeCombo"
                                  Width="105"
                                  SelectionChanged="GppDataSourcesFilter_SelectionChanged"/>
                        <TextBlock Text="Type:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppDataSourcesTypeCombo"
                                  Width="120"
                                  SelectionChanged="GppDataSourcesFilter_SelectionChanged"/>
                        <Button Content="Load all" Click="LoadGppDataSources_Click"/>
                        <Button Content="New..." Click="NewGppDataSource_Click"/>
                        <Button Content="Edit" Click="EditGppDataSource_Click"/>
                        <Button Content="Clone..." Click="CloneGppDataSource_Click"/>
                        <Button Content="Delete" Click="DeleteGppDataSource_Click"/>
                        <Button Content="Show raw XML" Click="ShowGppDataSourceRawXml_Click"/>
                        <TextBlock x:Name="GppDataSourcesCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppDataSourcesGrid"
                              MouseDoubleClick="GppDataSourcesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="85"/>
                            <DataGridTextColumn Header="DSN type" Binding="{Binding DsnTypeDisplay}" Width="100"/>
                            <DataGridTextColumn Header="DSN" Binding="{Binding Dsn}" Width="1.2*"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="1.5*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding DsnDescription}" Width="1.4*"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="1.1*"/>
                            <DataGridTextColumn Header="Attributes" Binding="{Binding AttributesPreview}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Legacy credential" Binding="{Binding HasStoredCredential}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Item disabled" Binding="{Binding Disabled}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Targeting" Binding="{Binding HasFilters}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Power Options"
                     Loaded="GppPowerOptionsTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="GppPowerOptionsSearchBox"
                                 Width="280"
                                 TextChanged="GppPowerOptionsSearchBox_TextChanged"/>
                        <TextBlock Text="Scope:"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppPowerOptionsScopeCombo"
                                  Width="105"
                                  SelectionChanged="GppPowerOptionsFilter_SelectionChanged"/>
                        <TextBlock Text="Type:"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppPowerOptionsTypeCombo"
                                  Width="150"
                                  SelectionChanged="GppPowerOptionsFilter_SelectionChanged"/>
                        <Button Content="Load all"
                                Click="LoadGppPowerOptions_Click"/>
                        <Button Content="New..."
                                Click="NewGppPowerOption_Click"/>
                        <Button Content="Edit"
                                Click="EditGppPowerOption_Click"/>
                        <Button Content="Clone..."
                                Click="CloneGppPowerOption_Click"/>
                        <Button Content="Delete"
                                Click="DeleteGppPowerOption_Click"/>
                        <Button Content="Show raw XML"
                                Click="ShowGppPowerOptionRawXml_Click"/>
                        <TextBlock x:Name="GppPowerOptionsCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppPowerOptionsGrid"
                              MouseDoubleClick="GppPowerOptionsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO"
                                                Binding="{Binding GpoName}"
                                                Width="1.3*"/>
                            <DataGridTextColumn Header="Scope"
                                                Binding="{Binding Scope}"
                                                Width="85"/>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding KindDisplay}"
                                                Width="1.3*"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding DisplayName}"
                                                Width="1.4*"/>
                            <DataGridTextColumn Header="Action"
                                                Binding="{Binding ActionDisplay}"
                                                Width="85"/>
                            <DataGridTextColumn Header="Plan GUID"
                                                Binding="{Binding PlanGuid}"
                                                Width="260"/>
                            <DataGridCheckBoxColumn Header="Default"
                                                    Binding="{Binding SetAsDefault}"
                                                    Width="75"/>
                            <DataGridTextColumn Header="Sleep AC"
                                                Binding="{Binding SleepAfterAc}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Sleep DC"
                                                Binding="{Binding SleepAfterDc}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Display AC"
                                                Binding="{Binding DisplayOffAc}"
                                                Width="85"/>
                            <DataGridTextColumn Header="Display DC"
                                                Binding="{Binding DisplayOffDc}"
                                                Width="85"/>
                            <DataGridCheckBoxColumn Header="Item disabled"
                                                    Binding="{Binding Disabled}"
                                                    Width="90"/>
                            <DataGridCheckBoxColumn Header="Targeting"
                                                    Binding="{Binding HasFilters}"
                                                    Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Environment" Loaded="GppEnvironmentTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppEnvironmentSearchBox"
                                 Width="320"
                                 TextChanged="GppEnvironmentSearchBox_TextChanged"/>
                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppEnvironmentScopeCombo"
                                  Width="105"
                                  SelectionChanged="GppEnvironmentScopeCombo_SelectionChanged"/>
                        <Button Content="Load all" Click="LoadGppEnvironment_Click"/>
                        <Button Content="New..." Click="NewGppEnvironment_Click"/>
                        <Button Content="Edit" Click="EditGppEnvironment_Click"/>
                        <Button Content="Clone..." Click="CloneGppEnvironment_Click"/>
                        <Button Content="Delete" Click="DeleteGppEnvironment_Click"/>
                        <Button Content="Show raw XML" Click="ShowGppEnvironmentRawXml_Click"/>
                        <TextBlock x:Name="GppEnvironmentCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppEnvironmentGrid"
                              MouseDoubleClick="GppEnvironmentGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="85"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding VariableTypeDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Partial PATH" Binding="{Binding PartialPath}" Width="90"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.4*"/>
                            <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Targeting" Binding="{Binding HasFilters}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Regional Options"
                     Loaded="GppRegionalOptionsTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="GppRegionalOptionsSearchBox"
                                 Width="300"
                                 TextChanged="GppRegionalOptionsSearchBox_TextChanged"/>
                        <Button Content="Load all"
                                Click="LoadGppRegionalOptions_Click"/>
                        <Button Content="New..."
                                Click="NewGppRegionalOption_Click"/>
                        <Button Content="Edit"
                                Click="EditGppRegionalOption_Click"/>
                        <Button Content="Clone..."
                                Click="CloneGppRegionalOption_Click"/>
                        <Button Content="Delete"
                                Click="DeleteGppRegionalOption_Click"/>
                        <Button Content="Show raw XML"
                                Click="ShowGppRegionalOptionRawXml_Click"/>
                        <TextBlock x:Name="GppRegionalOptionsCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppRegionalOptionsGrid"
                              MouseDoubleClick="GppRegionalOptionsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO"
                                                Binding="{Binding GpoName}"
                                                Width="1.4*"/>
                            <DataGridTextColumn Header="Locale"
                                                Binding="{Binding LocaleName}"
                                                Width="1.5*"/>
                            <DataGridTextColumn Header="LCID"
                                                Binding="{Binding LocaleId}"
                                                Width="85"/>
                            <DataGridTextColumn Header="Number decimal"
                                                Binding="{Binding NumberDecimalSymbol}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Currency"
                                                Binding="{Binding CurrencySymbol}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Time"
                                                Binding="{Binding TimeFormat}"
                                                Width="1.1*"/>
                            <DataGridTextColumn Header="Short date"
                                                Binding="{Binding ShortDateFormat}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Long date"
                                                Binding="{Binding LongDateFormat}"
                                                Width="1.8*"/>
                            <DataGridCheckBoxColumn Header="Item disabled"
                                                    Binding="{Binding Disabled}"
                                                    Width="90"/>
                            <DataGridCheckBoxColumn Header="Targeting"
                                                    Binding="{Binding HasFilters}"
                                                    Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Services" Loaded="GppServicesTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppServicesSearchBox"
                                 Width="330"
                                 TextChanged="GppServicesSearchBox_TextChanged"/>
                        <Button Content="Load all" Click="LoadGppServices_Click"/>
                        <Button Content="New..." Click="NewGppService_Click"/>
                        <Button Content="Edit" Click="EditGppService_Click"/>
                        <Button Content="Clone..." Click="CloneGppService_Click"/>
                        <Button Content="Delete" Click="DeleteGppService_Click"/>
                        <Button Content="Show raw XML" Click="ShowGppServiceRawXml_Click"/>
                        <TextBlock x:Name="GppServicesCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppServicesGrid"
                              MouseDoubleClick="GppServicesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Service action" Binding="{Binding ServiceAction}" Width="135"/>
                            <DataGridTextColumn Header="Startup" Binding="{Binding StartupType}" Width="105"/>
                            <DataGridTextColumn Header="Timeout" Binding="{Binding Timeout}" Width="75"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="1.2*"/>
                            <DataGridTextColumn Header="1st failure" Binding="{Binding FirstFailure}" Width="120"/>
                            <DataGridTextColumn Header="2nd failure" Binding="{Binding SecondFailure}" Width="120"/>
                            <DataGridTextColumn Header="3rd failure" Binding="{Binding ThirdFailure}" Width="120"/>
                            <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Targeting" Binding="{Binding HasFilters}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Legacy credential" Binding="{Binding HasStoredCredential}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Drive Maps" Loaded="GppDrivesTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppDrivesSearchBox"
                                 Width="330"
                                 TextChanged="GppDrivesSearchBox_TextChanged"/>
                        <Button Content="Load all" Click="LoadGppDrives_Click"/>
                        <Button Content="New..." Click="NewGppDrive_Click"/>
                        <Button Content="Edit" Click="EditGppDrive_Click"/>
                        <Button Content="Clone..." Click="CloneGppDrive_Click"/>
                        <Button Content="Delete" Click="DeleteGppDrive_Click"/>
                        <Button Content="Show raw XML" Click="ShowGppDriveRawXml_Click"/>
                        <TextBlock x:Name="GppDrivesCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppDrivesGrid"
                              MouseDoubleClick="GppDrivesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Drive" Binding="{Binding DriveDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="1.8*"/>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="1.1*"/>
                            <DataGridCheckBoxColumn Header="Reconnect" Binding="{Binding Persistent}" Width="85"/>
                            <DataGridTextColumn Header="Connect as" Binding="{Binding UserName}" Width="1.1*"/>
                            <DataGridTextColumn Header="This drive" Binding="{Binding ThisDriveVisibility}" Width="90"/>
                            <DataGridTextColumn Header="All drives" Binding="{Binding AllDrivesVisibility}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Targeting" Binding="{Binding HasFilters}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Legacy credential" Binding="{Binding HasStoredCredential}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Registry" Loaded="GppRegistryTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppRegistrySearchBox"
                                 Width="330"
                                 TextChanged="GppRegistrySearchBox_TextChanged"/>
                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppRegistryScopeCombo"
                                  Width="115"
                                  SelectionChanged="GppRegistryScopeCombo_SelectionChanged"/>
                        <Button Content="Load all" Click="LoadGppRegistry_Click"/>
                        <Button Content="New..." Click="NewGppRegistry_Click"/>
                        <Button Content="Edit" Click="EditGppRegistry_Click"/>
                        <Button Content="Clone..." Click="CloneGppRegistry_Click"/>
                        <Button Content="Delete" Click="DeleteGppRegistry_Click"/>
                        <Button Content="Open Registry.xml" Click="OpenGppRegistryXml_Click"/>
                        <TextBlock x:Name="GppRegistryCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppRegistryGrid"
                              MouseDoubleClick="GppRegistryGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.4*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Hive" Binding="{Binding Hive}" Width="145"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="1.8*"/>
                            <DataGridTextColumn Header="Value name" Binding="{Binding ValueName}" Width="1.1*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="105"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueData}" Width="1.5*"/>
                            <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Targeting" Binding="{Binding HasFilters}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Shortcuts" Loaded="GppShortcutsTab_Loaded">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GppShortcutsSearchBox"
                                 Width="320"
                                 TextChanged="GppShortcutsSearchBox_TextChanged"/>
                        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ComboBox x:Name="GppShortcutsScopeCombo"
                                  Width="105"
                                  SelectionChanged="GppShortcutsScopeCombo_SelectionChanged"/>
                        <Button Content="Load all" Click="LoadGppShortcuts_Click"/>
                        <Button Content="New..." Click="NewGppShortcut_Click"/>
                        <Button Content="Edit" Click="EditGppShortcut_Click"/>
                        <Button Content="Clone..." Click="CloneGppShortcut_Click"/>
                        <Button Content="Delete" Click="DeleteGppShortcut_Click"/>
                        <Button Content="Show raw XML" Click="ShowGppShortcutRawXml_Click"/>
                        <TextBlock x:Name="GppShortcutsCountText"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="DimGray"/>
                    </WrapPanel>

                    <DataGrid x:Name="GppShortcutsGrid"
                              MouseDoubleClick="GppShortcutsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="85"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="85"/>
                            <DataGridTextColumn Header="Shortcut path" Binding="{Binding ShortcutPath}" Width="1.7*"/>
                            <DataGridTextColumn Header="Target type" Binding="{Binding TargetTypeDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetPath}" Width="1.7*"/>
                            <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="1.1*"/>
                            <DataGridTextColumn Header="Icon" Binding="{Binding IconPath}" Width="1.1*"/>
                            <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding Disabled}" Width="75"/>
                            <DataGridCheckBoxColumn Header="Targeting" Binding="{Binding HasFilters}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPP Files &amp; Folders" Loaded="GppFilesFoldersTab_Loaded">
                <TabControl Margin="6">
                    <TabItem Header="Files">
                        <DockPanel Margin="6">
                            <WrapPanel DockPanel.Dock="Top">
                                <TextBlock Text="Search:" VerticalAlignment="Center"/>
                                <TextBox x:Name="GppFilesSearchBox"
                                         Width="300"
                                         TextChanged="GppFilesSearchBox_TextChanged"/>
                                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ComboBox x:Name="GppFilesScopeCombo"
