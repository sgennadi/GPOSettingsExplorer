<Window x:Class="GPOSettingsExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPO Settings Explorer"
        Width="1500" Height="900"
        MinWidth="1100" MinHeight="650"
        Loaded="MainWindow_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Domain:" Margin="0,0,6,0"/>
                <TextBlock x:Name="DomainText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Connected DC:" Margin="12,0,6,0"/>
                <TextBlock x:Name="ServerText" Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeaderStatusText" Grid.Column="4" VerticalAlignment="Center" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="5" Content="Refresh all" Click="RefreshAll_Click"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="BusyProgress" Width="180" Height="14" IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="MainTabs">
            <TabItem Header="GPOs">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="GpoSearchBox" Width="340" TextChanged="GpoSearchBox_TextChanged"/>
                        <Button Content="New GPO..." Click="NewGpo_Click"/>
                        <Button Content="Rename" Click="RenameGpo_Click"/>
                        <Button Content="Delete" Click="DeleteGpo_Click"/>
                        <Button Content="Open editor" Click="OpenGpoEditor_Click"/>
                        <Button Content="Backup selected" Click="BackupSelectedGpo_Click"/>
                        <Button Content="Build settings index" Click="BuildSettingsIndex_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Toggle Computer" Click="ToggleComputerScope_Click"/>
                        <Button Content="Toggle User" Click="ToggleUserScope_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Assign WMI filter" Click="AssignWmiFilter_Click"/>
                        <Button Content="Remove WMI filter" Click="RemoveWmiFilter_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GpoGrid" MouseDoubleClick="GpoGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeState}" Width="150"/>
                            <DataGridTextColumn Header="WMI Filter" Binding="{Binding WmiFilterName}" Width="1.3*"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ModificationTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155"/>
                            <DataGridTextColumn Header="GUID" Binding="{Binding IdText}" Width="270"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="All Settings">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Search all configured settings:" VerticalAlignment="Center"/>
                        <TextBox x:Name="SettingsSearchBox" Width="460" TextChanged="SettingsSearchBox_TextChanged"/>
                        <Button Content="Rebuild index" Click="BuildSettingsIndex_Click"/>
                        <Button Content="Edit setting" Click="EditSetting_Click"/>
                        <Button Content="Open selected GPO" Click="OpenSettingGpo_Click"/>
                        <Button Content="Export CSV" Click="ExportSettingsCsv_Click"/>
                        <TextBlock x:Name="SettingsCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </StackPanel>
                    <DataGrid x:Name="SettingsGrid" MouseDoubleClick="EditSetting_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.4*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                            <DataGridTextColumn Header="Setting" Binding="{Binding SettingName}" Width="2*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.6*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding RegistryKey}" Width="1.5*"/>
                            <DataGridTextColumn Header="Registry value" Binding="{Binding RegistryValue}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="ADMX Catalog">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Search all Administrative Template policies:" VerticalAlignment="Center"/>
                        <TextBox x:Name="AdmxSearchBox" Width="440" TextChanged="AdmxSearchBox_TextChanged"/>
                        <Button Content="Load catalog" Click="LoadAdmxCatalog_Click"/>
                        <Button Content="Configure in GPO..." Click="ConfigureAdmxPolicy_Click"/>
                        <TextBlock x:Name="AdmxCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </StackPanel>
                    <DataGrid x:Name="AdmxGrid" MouseDoubleClick="AdmxGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="100"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.7*"/>
                            <DataGridTextColumn Header="ADMX" Binding="{Binding AdmxFile}" Width="160"/>
                            <DataGridTextColumn Header="Registry key" Binding="{Binding Key}" Width="1.5*"/>
                            <DataGridTextColumn Header="Registry value" Binding="{Binding ValueName}" Width="1.1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="GPO Links">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Search links:" VerticalAlignment="Center"/>
                        <TextBox x:Name="LinkSearchBox" Width="360" TextChanged="LinkSearchBox_TextChanged"/>
                        <Button Content="Load links" Click="LoadLinks_Click"/>
                        <Button Content="New link..." Click="NewLink_Click"/>
                        <Button Content="Edit link..." Click="EditLink_Click"/>
                        <Button Content="Remove link" Click="RemoveLink_Click"/>
                        <Button Content="Toggle block inheritance" Click="ToggleBlockInheritance_Click"/>
                        <TextBlock x:Name="LinksCountText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </StackPanel>
                    <DataGrid x:Name="LinksGrid" MouseDoubleClick="LinksGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GPO" Binding="{Binding GpoName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TargetType}" Width="90"/>
                            <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Enforced" Binding="{Binding Enforced}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Block inheritance" Binding="{Binding BlockInheritance}" Width="120"/>
                            <DataGridTextColumn Header="Target DN" Binding="{Binding TargetDn}" Width="2.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Security &amp; Delegation">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="GPO:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SecurityGpoCombo"
                                  Width="330"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="SecurityGpoCombo_SelectionChanged"/>
                        <Button Content="Refresh" Click="RefreshSecurity_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Add Security Filter..." Click="AddSecurityFilter_Click"/>
                        <Button Content="Add Delegation..." Click="AddDelegation_Click"/>
                        <Button Content="Change..." Click="ChangePermission_Click"/>
                        <Button Content="Remove" Click="RemovePermission_Click"/>
                        <Separator Width="12"/>
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PermissionSearchBox" Width="230" TextChanged="PermissionSearchBox_TextChanged"/>
                        <TextBlock x:Name="PermissionCountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="DimGray"/>
                    </StackPanel>
                    <DataGrid x:Name="PermissionGrid" MouseDoubleClick="PermissionGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTextColumn Header="Trustee" Binding="{Binding TrusteeDisplay}" Width="1.5*"/>
                            <DataGridTextColumn Header="Permission" Binding="{Binding PermissionDisplay}" Width="1.7*"/>
                            <DataGridCheckBoxColumn Header="Inherited" Binding="{Binding Inherited}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Denied" Binding="{Binding Denied}" Width="70"/>
                            <DataGridTextColumn Header="SID" Binding="{Binding TrusteeSid}" Width="1.5*"/>
                            <DataGridTextColumn Header="Directory path" Binding="{Binding TrusteeDsPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="WMI Filters">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="Search:" VerticalAlignment="Center"/>
                        <TextBox x:Name="WmiSearchBox" Width="340" TextChanged="WmiSearchBox_TextChanged"/>
                        <Button Content="New" Click="NewWmiFilter_Click"/>
                        <Button Content="Edit" Click="EditWmiFilter_Click"/>
                        <Button Content="Clone" Click="CloneWmiFilter_Click"/>
                        <Button Content="Delete" Click="DeleteWmiFilter_Click"/>
                        <Separator Width="12"/>
                        <Button Content="Test on computer..." Click="TestWmiFilter_Click"/>
                        <Button Content="Show used GPOs" Click="ShowWmiUsage_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="WmiGrid" MouseDoubleClick="WmiGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.8*"/>
                            <DataGridTextColumn Header="Used by GPOs" Binding="{Binding UsedByCount}" Width="100"/>
                            <DataGridTextColumn Header="Rules" Binding="{Binding QueriesPreview}" Width="2.4*"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="1.1*"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding ChangeDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="270"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
