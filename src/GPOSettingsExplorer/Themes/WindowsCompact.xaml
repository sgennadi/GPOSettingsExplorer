<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="UiAccentBrush" Color="#1666A6"/>
    <SolidColorBrush x:Key="UiAccentSoftBrush" Color="#E9F3FC"/>
    <SolidColorBrush x:Key="UiSuccessBrush" Color="#18794E"/>
    <SolidColorBrush x:Key="UiWarningBrush" Color="#A76400"/>
    <SolidColorBrush x:Key="UiErrorBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="UiMutedBrush" Color="#596779"/>
    <SolidColorBrush x:Key="UiSurfaceBrush" Color="#EFF3F8"/>

    <!-- Semantic colors are centralized here; no per-window palettes. -->
    <SolidColorBrush x:Key="UiDisabledRowBrush" Color="#EDF0F3"/>
    <SolidColorBrush x:Key="UiPartialRowBrush" Color="#FFF7E7"/>
    <SolidColorBrush x:Key="UiMissingRowBrush" Color="#FFF0EE"/>
    <SolidColorBrush x:Key="UiUnassignedRowBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="UiFileBatchBrush" Color="#1762A3"/>
    <SolidColorBrush x:Key="UiFileCmdBrush" Color="#076C78"/>
    <SolidColorBrush x:Key="UiFilePowerShellBrush" Color="#7443AC"/>
    <SolidColorBrush x:Key="UiFileVbsBrush" Color="#A35C15"/>
    <SolidColorBrush x:Key="UiFileJavaScriptBrush" Color="#A66A00"/>
    <SolidColorBrush x:Key="UiFileOtherBrush" Color="#566477"/>
    <SolidColorBrush x:Key="UiScriptCommentBrush" Color="#24834D"/>
    <SolidColorBrush x:Key="UiScriptStringBrush" Color="#9A4E16"/>
    <SolidColorBrush x:Key="UiScriptKeywordBrush" Color="#245BBB"/>
    <SolidColorBrush x:Key="UiScriptVariableBrush" Color="#8450B2"/>
    <SolidColorBrush x:Key="UiScriptNumberBrush" Color="#0B7484"/>

    <!--
        Compact native Windows-oriented styling.
        All dimensions are device-independent pixels (DIPs), so WPF scales them
        correctly on 125/150/175/200% and per-monitor DPI changes.
    -->

    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily"
                Value="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"/>
        <Setter Property="FontSize"
                Value="{DynamicResource {x:Static SystemFonts.MessageFontSizeKey}}"/>
        <Setter Property="Background"
                Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="MinWidth" Value="54"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="UiPrimaryButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource UiAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="UiWriteModeToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Foreground" Value="{StaticResource UiSuccessBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource UiWarningBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource UiAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Margin" Value="3"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="MinColumnWidth" Value="90"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="MinRowHeight" Value="26"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- GPO states: disabled both scopes = grey; only one scope = amber. -->
    <Style x:Key="UiGpoRowStyle" TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ComputerEnabled}" Value="False"/>
                    <Condition Binding="{Binding UserEnabled}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource UiDisabledRowBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ComputerEnabled}" Value="True"/>
                    <Condition Binding="{Binding UserEnabled}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource UiPartialRowBrush}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding ComputerEnabled}" Value="False"/>
                    <Condition Binding="{Binding UserEnabled}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource UiPartialRowBrush}"/>
            </MultiDataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UiPolicyRowStyle" TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Disabled">
                <Setter Property="Background" Value="{StaticResource UiDisabledRowBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Not Configured">
                <Setter Property="Background" Value="{StaticResource UiDisabledRowBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource UiMutedBrush}"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UiScriptRowStyle" TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Referenced}" Value="False">
                <Setter Property="Background" Value="{StaticResource UiUnassignedRowBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Exists}" Value="False">
                <Setter Property="Background" Value="{StaticResource UiMissingRowBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource UiErrorBrush}"/>
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UiScriptTypeTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Foreground" Value="{StaticResource UiFileOtherBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="BAT">
                <Setter Property="Foreground" Value="{StaticResource UiFileBatchBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="CMD">
                <Setter Property="Foreground" Value="{StaticResource UiFileCmdBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="PS1">
                <Setter Property="Foreground" Value="{StaticResource UiFilePowerShellBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="PSM1">
                <Setter Property="Foreground" Value="{StaticResource UiFilePowerShellBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="PSD1">
                <Setter Property="Foreground" Value="{StaticResource UiFilePowerShellBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="VBS">
                <Setter Property="Foreground" Value="{StaticResource UiFileVbsBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="JS">
                <Setter Property="Foreground" Value="{StaticResource UiFileJavaScriptBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UiScriptMatchTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding MatchType}" Value="Content">
                <Setter Property="Foreground" Value="{StaticResource UiSuccessBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding MatchType}" Value="File name">
                <Setter Property="Foreground" Value="{StaticResource UiAccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding MatchType}" Value="Parameters">
                <Setter Property="Foreground" Value="{StaticResource UiWarningBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="WrappingColumnHeaderTemplate">
        <TextBlock Text="{Binding}"
                   TextWrapping="NoWrap"
                   TextTrimming="None"/>
    </DataTemplate>

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource UiSurfaceBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate"
                Value="{StaticResource WrappingColumnHeaderTemplate}"/>
        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
    </Style>

    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Padding" Value="3,1"/>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="3,1"/>
    </Style>

    <Style TargetType="{x:Type WrapPanel}">
        <Setter Property="Margin" Value="0,1"/>
    </Style>

    <Style x:Key="AdaptiveToolbarTextBox"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="MaxWidth" Value="480"/>
    </Style>

    <Style x:Key="AdaptiveHeaderValue"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="MaxWidth" Value="340"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AdaptiveFormLabel"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="Margin" Value="0,3,8,3"/>
    </Style>

    <Style x:Key="AdaptiveDialogButtonBar"
           TargetType="{x:Type WrapPanel}">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="AdaptiveMultilineTextBox"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>

</ResourceDictionary>
